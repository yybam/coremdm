rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null
          && request.auth.token.email == 'yybambi23@gmail.com'
          && request.auth.token.email_verified == true;
    }

    match /devices/{deviceId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      allow read, update: if request.auth != null
                          && (resource.data.ownerId == request.auth.uid || isSuperAdmin());

      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // Audit log — any authenticated user can write, only super admin can read
    match /audit_logs/{logId} {
      allow create: if request.auth != null;
      allow read:   if isSuperAdmin();
      allow update, delete: if false;
    }

    // Device inventory — pre-provisioning records
    match /device_inventory/{imei} {
      allow read, write: if isSuperAdmin();
      // Devices mark themselves ENROLLED after verifying their token client-side
      allow update: if request.auth != null
                    && resource.data.enrollmentStatus == 'PENDING'
                    && request.resource.data.enrollmentStatus == 'ENROLLED'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['enrollmentStatus', 'enrolledAt',
                                   'enrollmentToken', 'enrollmentTokenExpiresAt']);
    }

    // Enrollment token lookup — the 32-char random token itself is the secret.
    // Any signed-in device can look up its record; only super admin can create tokens.
    match /enrollment_tokens/{token} {
      allow read:   if request.auth != null;
      allow create: if isSuperAdmin();
      allow update: if false;
      allow delete: if request.auth != null;   // device consumes token after enrollment
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
