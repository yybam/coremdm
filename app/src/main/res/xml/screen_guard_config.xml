<?xml version="1.0" encoding="utf-8"?>
<!--
  Screen guard: watches the foreground screen so blocked in-app sections (WhatsApp Status,
  Instagram Reels, …) and in-app web pages can be dismissed. Android has no other way to block
  part of another app.

  packageNames is deliberately omitted: the per-app WebView rule applies to whichever app is
  in front, so the scope can't be a fixed list. The service itself checks the current rules
  first and returns immediately when nothing is blocked (GuardPolicy.Snapshot.isEmpty), and it
  never records, stores or transmits screen content — it only decides whether to press Back.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/screen_guard_description"
    android:summary="@string/screen_guard_summary"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:notificationTimeout="200" />
