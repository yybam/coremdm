rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Keep in step with isSuperAdmin() in firestore.rules.
    function isSuperAdmin() {
      return request.auth != null
          && request.auth.token.email in ['yybamberger1@gmail.com', 'yybambi23@gmail.com',
                                          'shmuelzevkatz@gmail.com', 'adschochet03@gmail.com'];
    }

    // APK updates — only super admins can upload; download URL is
    // public (contains a signed token) so the device needs no auth to fetch.
    match /apk-updates/{version}/{file} {
      allow write: if isSuperAdmin();
      allow read:  if request.auth != null;
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
