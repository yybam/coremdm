rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null
          && request.auth.token.email == 'yybambi23@gmail.com'
          && request.auth.token.email_verified == true;
    }

    match /devices/{deviceId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      allow read, update: if request.auth != null
                          && (resource.data.ownerId == request.auth.uid || isSuperAdmin());

      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // Audit log — any authenticated user can write, only super admin can read
    match /audit_logs/{logId} {
      allow create: if request.auth != null;
      allow read:   if isSuperAdmin();
      allow update, delete: if false;
    }

    // Device inventory — pre-provisioning records, only super admin can access
    match /device_inventory/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
