rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // APK updates — only the super-admin can upload; download URL is
    // public (contains a signed token) so the device needs no auth to fetch.
    match /apk-updates/{version}/{file} {
      allow write: if request.auth != null
                   && request.auth.token.email == 'yybamberger1@gmail.com';
      allow read:  if request.auth != null;
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
